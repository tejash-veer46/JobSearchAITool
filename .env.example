# Copy to .env and fill in. Never commit .env.

# Optional. Without it, JobApplyAI scores jobs with built-in rules and keyword
# matching. With it, Claude does the resume parsing and job scoring.
ANTHROPIC_API_KEY=
CLAUDE_MODEL=claude-sonnet-5-5

# Optional free key from https://developer.adzuna.com/ (adds India-wide listings)
ADZUNA_APP_ID=
ADZUNA_APP_KEY=

# Where your resume lives (PDF or DOCX). A folder picks the newest file in it.
RESUME_PATH=resume
